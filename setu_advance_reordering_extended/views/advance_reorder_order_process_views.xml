<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fg_demand_planning_tree" model="ir.ui.view">
        <field name="name">advance.reorder.orderprocess.line.tree.planning</field>
        <field name="model">advance.reorder.orderprocess.line</field>
        <field name="arch" type="xml">
            <list string="FG Demand Calculation" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="demand_adjustment_qty" string="Demand"/>
            </list>
        </field>
    </record>

    <record id="view_advance_reorder_planning_line_tree" model="ir.ui.view">
        <field name="name">advance.reorder.planning.line.tree</field>
        <field name="model">advance.reorder.planning.line</field>
        <field name="arch" type="xml">
            <list string="Planning Demand Details" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="net_demand" string="Net Demand"/>
            </list>
        </field>
    </record>

    <record id="form_advance_reorder_orderprocess_extended" model="ir.ui.view">
        <field name="name">advance.reorder.orderprocess.form.extended</field>
        <field name="model">advance.reorder.orderprocess</field>
        <field name="inherit_id" ref="setu_advance_reordering.form_advance_reorder_orderprocess"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='generate_demand_with']" position="after">
                <field name="calculate_demand_based_on_selected_bom" readonly="state != 'draft'" invisible="generate_demand_with == 'forecast_sales'"/>
                <field name="has_purchase_action_summary" invisible="1"/>
                <field name="has_production_action_summary" invisible="1"/>
                <field name="show_subcontracting_qty" invisible="1"/>
                <field name="show_scrap_qty" invisible="1"/>
            </xpath>

            <xpath expr="//header/button[@name='action_create_reorder_purchase_order']" position="attributes">
                <attribute name="invisible">state != 'verified' or not has_purchase_action_summary</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_create_reorder_purchase_order']" position="after">
                <button name="action_create_reorder_manufacturing_orders" string="Create MO" type="object"
                        invisible="state != 'verified' or not has_production_action_summary or production_count > 0"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="production_count" invisible="1"/>
                <button type="object"
                        name="action_production_count"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="production_count == 0">
                    <field name="production_count" widget="statinfo" string="Manufacturing Orders"/>
                </button>
                <field name="fg_count" invisible="1"/>
                <field name="sfg_count" invisible="1"/>
                <field name="component_count" invisible="1"/>
                <button type="object"
                        name="action_view_fg"
                        class="oe_stat_button"
                        icon="fa-cube"
                        invisible="fg_count == 0">
                    <field name="fg_count" widget="statinfo" string="FG"/>
                </button>
                <button type="object"
                        name="action_view_sfg"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="sfg_count == 0">
                    <field name="sfg_count" widget="statinfo" string="SFG"/>
                </button>
                <button type="object"
                        name="action_view_components"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="component_count == 0">
                    <field name="component_count" widget="statinfo" string="Components"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='reorder_product']//field[@name='product_ids']//field[@name='virtual_available']"
                   position="after">
                <field name="reorder_product_classification" string="Classification"
                       optional="hide"/>
                <field name="reorder_bom_id" string="BOM" optional="show"
                       domain="['|', ('product_id', '=', id), '&amp;', ('product_tmpl_id', '=', product_tmpl_id), ('product_id', '=', False)]"
                       readonly="reorder_product_classification not in ('finished_good', 'semi_finished_good')"
                       column_invisible="parent.calculate_demand_based_on_selected_bom != True"
                />
                <field name="reorder_bom_type" readonly="1" optional="show"
                       column_invisible="parent.calculate_demand_based_on_selected_bom != True"/>
                <field name="route_ids" widget="many2many_tags" string="Routes" optional="show"
                       readonly="1"/>
                <field name="demand_planning_type" string="Demand Planning Type" required="1"
                       optional="show" column_invisible="parent.generate_demand_with == 'forecast_sales'"/>
            </xpath>

            <xpath expr="//page[@name='reorder_lines']//field[@name='transit_time_sales']" position="before">
                <field name="sales_qty" optional="show"/>
                <field name="sales_return_qty" optional="hide"/>
                <field name="consumed_qty" optional="show"/>
                <field name="resupply_qty" optional="show"
                       column_invisible="parent.show_subcontracting_qty == False"/>
                <field name="resupply_return_qty" optional="hide"
                       column_invisible="parent.show_subcontracting_qty == False"/>
                <field name="scrap_qty" optional="show" column_invisible="not parent.show_scrap_qty"/>
            </xpath>

            <page name="reorder_summary" position="before">
                <page string="To Be Produced" name="reorder_to_be_produced"
                      invisible="not to_be_produced_line_ids">
                    <field name="to_be_produced_line_ids" nolabel="1"
                           readonly="1">
                        <list string="To Be Produced" create="false" delete="false">
                            <field name="config_id" column_invisible="1"/>
                            <field name="warehouse_group_id" optional="hide"/>
                            <field name="product_id"/>
                            <field name="bom_id" optional="show"/>
                            <field name="bom_type" optional="show"/>
                            <field name="available_qty" optional="show"/>
                            <field name="required_qty" optional="show"/>
                            <button name="action_view_source_products"
                                    type="object"
                                    title="Source Products"
                                    icon="fa-sitemap"/>
                            <field name="incoming_qty" optional="show"/>
                            <button class="oe_stat_button oe_inline"
                                    name="action_incoming_stock_moves"
                                    type="object"
                                    icon="fa-exchange"
                                    title="Incoming Stock Moves"/>
                            <field name="scrap_qty" optional="show"/>
                            <field name="net_demand" optional="show"/>
                            <field name="demand_adjustment_qty" optional="show"/>
                        </list>
                        <form string="To Be Produced" create="false" delete="false">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="product_id" readonly="1"/>
                                        <field name="available_qty" readonly="1"/>
                                        <field name="incoming_qty" readonly="1"/>
                                        <field name="net_demand" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="bom_id" readonly="1"/>
                                        <field name="required_qty" readonly="1"/>
                                        <field name="scrap_qty" readonly="1"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page string="Components Demand Calculation" name="reorder_component_demand"
                      invisible="not component_demand_line_ids">
                    <field name="component_demand_line_ids" nolabel="1"
                           readonly="state in ['done', 'cancel', 'verified']">
                        <list string="Component Demand" create="false" delete="false">
                            <field name="warehouse_group_id" optional="hide"/>
                            <field name="product_id" readonly="1"/>
                            <field name="available_qty" readonly="1" optional="show"/>
                            <field name="required_qty" readonly="1" optional="show"/>
                            <button name="action_view_source_products"
                                    type="object"
                                    title="Source Products"
                                    icon="fa-sitemap"/>
                            <field name="incoming_qty" readonly="1" optional="show"/>
                            <button class="oe_stat_button oe_inline"
                                    name="action_incoming_stock_moves"
                                    type="object"
                                    icon="fa-exchange"
                                    title="Incoming Stock Moves"/>
                            <field name="scrap_qty" optional="show"/>
                            <field name="net_demand" readonly="1" optional="show"/>
                             <field name="demand_adjustment_qty" optional="show"/>
                        </list>
                        <form string="Component Demand" create="false" delete="false">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="product_id" readonly="1"/>
                                        <field name="available_qty" readonly="1"/>
                                        <field name="required_qty" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="incoming_qty" readonly="1"/>
                                        <field name="net_demand" readonly="1"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page string="By Product" name="reorder_by_product"
                      invisible="not by_product_line_ids">
                    <field name="by_product_line_ids" nolabel="1" readonly="1">
                        <list string="By Product" create="false" delete="false">
                            <field name="warehouse_group_id" optional="hide"/>
                            <field name="source_product_id"/>
                            <field name="product_id"/>
                            <field name="source_product_demand"/>
                            <field name="quantity"/>
                        </list>
                        <form string="By Product" create="false" delete="false">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="source_product_id" readonly="1" optional="show"/>
                                        <field name="product_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="source_product_demand" readonly="1" optional="show"/>
                                        <field name="quantity" readonly="1" optional="show"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </page>

            <xpath expr="//page[@name='reorder_summary']//field[@name='summary_ids']" position="replace">
                <field name="summary_ids" nolabel="1">
                    <list string="Summary" create="0" delete="0" editable="bottom">
                        <field name="warehouse_group_id" optional="hide"/>
                        <field name="product_id" readonly="1"/>
                        <field name="product_volume" readonly="1"/>
                        <field name="volume_uom_name" string="Volume UOM" readonly="1"/>
                        <field name="product_weight" readonly="1"/>
                        <field name="weight_uom_name" string="Weight UOM" readonly="1"/>
                        <field name="demanded_qty" readonly="1"/>
                        <field name="vendor_moq" readonly="1"/>
                        <field name="order_qty" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="to_be_ordered_in_purchase_uom" readonly="1"/>
                        <field name="uom_po_id" readonly="1"/>
                        <field name="total_volume" readonly="1"/>
                        <field name="volume_uom_name" string="Volume UOM" readonly="1"/>
                        <field name="is_order_moq" column_invisible="True" readonly="1"/>
                        <field name="order_action" readonly="parent.state in ('done', 'cancel')"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
