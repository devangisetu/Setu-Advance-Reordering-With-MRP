<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_create_reordering_inherit" model="ir.ui.view">
        <field name="name">create.reordering.wizard.inherit</field>
        <field name="model">create.reordering</field>
        <field name="inherit_id" ref="setu_advance_reordering.form_create_reordering"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='update_purchase_history']" position="replace">
                <button name="update_purchase_history" string="Update Purchase Orders"
                        invisible="operation != 'purchase_history'" type="object"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='update_iwt_history']" position="replace">
                <button name="update_iwt_history" string="Update IWT Orders"
                        invisible="operation != 'iwt_history'" type="object"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='update_iwt_history']" position="after">
                <field name="use_subcontracting_for_orderpoint" invisible="1"/>
                <field name="use_scrap_for_orderpoint" invisible="1"/>
                <button name="update_production_history" string="Update Production Orders"
                        invisible="operation != 'production_history'" type="object"
                        class="oe_highlight"/>
                <button name="update_consumption_history" string="Update Consumption History"
                        invisible="operation != 'consumption_history'" type="object"
                        class="oe_highlight"/>
                <button name="update_resupply_history" string="Update Resupply History"
                        invisible="operation != 'resupply_history'" type="object"
                        class="oe_highlight"/>
                <button name="update_subcontract_history" string="Update Subcontracting Orders"
                        invisible="operation != 'subcontract_history'" type="object"
                        class="oe_highlight"/>
                <button name="update_scrap_history" string="Update Scrap History"
                        invisible="operation != 'scrap_history'" type="object"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='add_iwt_in_lead_calc']" position="after">
                <field name="add_mo_in_lead_calc" invisible="operation != 'orderpoint'"/>
                <field name="use_subcontracting_for_orderpoint" invisible="1"/>
                <field name="add_sc_in_lead_calc" invisible="operation != 'orderpoint' or not use_subcontracting_for_orderpoint"/>
            </xpath>
            <xpath expr="//field[@name='average_sale_calculation_base']" position="after">
                <field name="demand_planning_type" invisible="operation != 'orderpoint' or orderpoint_operation == 'update_order_point'"/>
            </xpath>
            <xpath expr="//field[@name='location_selection_strategy']" position="after">
                <separator string="Auto Orderpoint" invisible="operation != 'orderpoint' or orderpoint_operation not in ['create_order_point', 'update_order_point']" style="margin-top: 25px; font-size: 18px;"/>
                <field name="auto_create_components_orderpoint" widget="boolean_toggle" invisible="operation != 'orderpoint' or orderpoint_operation != 'create_order_point'"/>
                <field name="specific_bom" widget="boolean_toggle" invisible="operation != 'orderpoint' or orderpoint_operation != 'create_order_point'"/>
                <field name="component_warehouse_ids" invisible="operation != 'orderpoint' or orderpoint_operation != 'create_order_point' or not auto_create_components_orderpoint">
                    <list editable="bottom">
                        <field name="company_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="warehouse_id" options="{'no_create': True, 'no_edit': True}"/>
                    </list>
                </field>
                <field name="update_component_orderpoint" widget="boolean_toggle" invisible="operation != 'orderpoint' or orderpoint_operation != 'update_order_point'"/>
            </xpath>
            <xpath expr="//field[@name='product_ids']" position="before">
                <field name="product_domain_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', product_domain_ids), ('type', '!=', 'combo')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
