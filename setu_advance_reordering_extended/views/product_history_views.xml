<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product Production History Views -->
        <record id="product_production_history_tree" model="ir.ui.view">
            <field name="name">product.production.history.tree</field>
            <field name="model">product.production.history</field>
            <field name="arch" type="xml">
                <list string="Production Orders History">
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <field name="orderpoint_id"/>
                    <field name="production_id"/>
                    <field name="mo_date"/>
                    <field name="produced_qty"/>
                    <field name="lead_time"/>
                </list>
            </field>
        </record>

        <record id="product_production_history_search" model="ir.ui.view">
            <field name="name">product.production.history.search</field>
            <field name="model">product.production.history</field>
            <field name="arch" type="xml">
                <search string="Production Orders History">
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <field name="orderpoint_id"/>
                    <field name="mo_date"/>
                    <separator/>
                    <filter string="Warehouse" context="{'group_by':'warehouse_id'}" name="warehouse_id_groupby"/>
                    <filter string="Product" context="{'group_by':'product_id'}" name="product_id_groupby"/>
                    <filter string="Date" context="{'group_by':'mo_date'}" name="mo_date_groupby"/>
                </search>
            </field>
        </record>

        <record id="product_production_history_graph" model="ir.ui.view">
            <field name="name">product.production.history.graph</field>
            <field name="model">product.production.history</field>
            <field name="arch" type="xml">
                <graph string="Production Orders Analysis" type="bar" stacked="False">
                    <field name="warehouse_id" type="col"/>
                    <field name="mo_date" type="row"/>
                    <field name="produced_qty" type="measure"/>
                    <field name="lead_time" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="product_production_history_pivot" model="ir.ui.view">
            <field name="name">product.production.history.pivot</field>
            <field name="model">product.production.history</field>
            <field name="arch" type="xml">
                <pivot string="Production Orders Analysis">
                    <field name="warehouse_id" type="col"/>
                    <field name="mo_date" type="row"/>
                    <field name="produced_qty" type="measure"/>
                    <field name="lead_time" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="product_production_history_action" model="ir.actions.act_window">
            <field name="name">Production Orders Analysis</field>
            <field name="res_model">product.production.history</field>
            <field name="binding_view_types">list,graph</field>
            <field name="view_mode">list,pivot,graph</field>
        </record>

