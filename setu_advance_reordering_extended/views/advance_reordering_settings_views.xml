<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advance_reordering_extended_settings_view_form_inherited" model="ir.ui.view">
        <field name="name">advance.reordering.extended.settings.view.form.inherited</field>
        <field name="model">advance.reordering.settings</field>
        <field name="inherit_id" ref="setu_advance_reordering.advance_reordering_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='advance_reordering_vendor_lead']"
                   position="after">
                <div class="mt16 mb16">
                    <h3>Scrap &amp; Subcontracting Settings</h3>
                </div>
                <div class="row mt16 o_settings_container" name="advance_reordering_with_scrap_and_subcontracting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <label for="consider_scrap"/>
                            <field name="consider_scrap"/>
                            <div class="text-muted">
                                Enable this option to include FG/SFG/Component Loss (during manufacturing)
                                <br/>
                                while calculating Real Demand in Advance Reordering.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <field name="use_subcontracting"/>
                            <label for="use_subcontracting"/>
                            <div class="text-muted">
                                Enable this option to include Subcontracting Bill of Materials while calculating demand
                                <br></br>
                                in Advance Reordering with Real Demand.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="scrap_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="scrap_enabled" class="fw-bold"/>
                            <div class="text-muted">
                                Enable scrap history tab and configuration on reordering rules.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="subcontracting_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="subcontracting_enabled" class="fw-bold"/>
                            <div class="text-muted">
                                Enable subcontract history, resupply history tabs and lead time configuration on reordering rules.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt16 o_settings_container" invisible="not subcontracting_enabled">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <label for="subcontract_lead_calc_base_on"/>
                            <div class="text-muted">
                                Select whether lead time should be based on subcontractor lead time, actual subcontract history receipt, or static days.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="subcontract_lead_calc_base_on" class="o_light_label" widget="selection"/>
                                </div>
                            </div>
                        </div>
                        <br></br>
                        <div invisible="subcontract_lead_calc_base_on not in ['vendor_lead_time','real_time']">
                            <div>
                                <label for="subcontract_max_lead_days_calc_method"/>
                                <div class="text-muted">
                                    Method for Maximum Lead Days calculation: Actual Maximum Lead Time or Average + Extra Time.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="subcontract_max_lead_days_calc_method" class="o_light_label" widget="selection"/>
                                    </div>
                                </div>
                            </div>
                            <br></br>
                            <div invisible="subcontract_max_lead_days_calc_method != 'avg_extra_percentage'">
                                <label for="subcontract_extra_lead_percentage"/>
                                <div class="text-muted">
                                    Extra Percentage for Maximum Lead time of subcontract.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="subcontract_extra_lead_percentage" class="oe_inline" widget="percentage" style="text-align: right;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br></br>
            </xpath>
        </field>
    </record>
</odoo>