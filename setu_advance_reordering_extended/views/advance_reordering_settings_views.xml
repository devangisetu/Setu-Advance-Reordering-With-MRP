<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advance_reordering_extended_settings_view_form_inherited" model="ir.ui.view">
        <field name="name">advance.reordering.extended.settings.view.form.inherited</field>
        <field name="model">advance.reordering.settings</field>
        <field name="inherit_id" ref="setu_advance_reordering.advance_reordering_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='advance_reordering_vendor_lead']"
                   position="after">
                <br></br>
                <div class="row mt16 o_settings_container" name="advance_reordering_with_scrap">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <field name="consider_component_loss"/>
                            <label for="consider_component_loss"/>
                            <div class="text-muted">
                                Enable this option to include Component Loss (material loss during manufacturing)
                                <br/>
                                while calculating Real Demand in Advance Reordering.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <field name="consider_production_rejection"/>
                            <label for="consider_production_rejection"/>
                            <div class="text-muted">
                                Enable this option to include Production Rejections (rejected Finished/Semi-finished
                                products)
                                <br/>
                                while calculating Real Demand in Advance Reordering.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <field name="consider_both"/>
                            <label for="consider_both"/>
                            <div class="text-muted">
                                Enable this option to include both Component Loss and Production Rejections
                                <br/>
                                while calculating Real Demand in Advance Reordering.
                            </div>
                        </div>
                    </div>

                </div>
                <br></br>
                <div class="row mt16 o_settings_container" name="advance_reordering_with_subcontracting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div>
                            <field name="use_subcontracting"/>
                            <label for="use_subcontracting"/>
                            <div class="text-muted">
                                Enable this option to include Subcontracting Bill of Materials while calculating demand
                                <br></br>
                                in Advance Reordering with Real Demand.
                            </div>
                        </div>
                    </div>
                </div>
                <br></br>
            </xpath>
        </field>
    </record>
</odoo>
