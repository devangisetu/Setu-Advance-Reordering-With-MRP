<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_reorder_mrp_wizard_form" model="ir.ui.view">
        <field name="name">advance.reorder.mrp.wizard.form</field>
        <field name="model">advance.reorder.mrp.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Manufacturing Orders">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="reorder_process_id" readonly="1"
                                   invisible="not reorder_process_id"/>
                            <field name="product_wise_reorder_id" readonly="1"
                                   invisible="not product_wise_reorder_id"/>
                        </group>
                        <group>
                            <field name="warehouse_id" required="1" options="{'no_create': True}"
                                   domain="[('company_id', '=', company_id)]"/>
                        </group>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list create="false" delete="false">
                            <field name="summary_line_id" column_invisible="1"/>
                            <field name="product_wise_summary_line_id" column_invisible="1"/>
                            <field name="warehouse_group_id" readonly="1"
                                   column_invisible="not parent.reorder_process_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="order_qty" string="Manufacturing Qty" readonly="1"/>
                        </list>
                    </field>

                </sheet>

                <footer>
                    <button name="action_confirm"
                            string="Create Manufacturing Orders"
                            type="object"
                            class="btn-primary"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>
