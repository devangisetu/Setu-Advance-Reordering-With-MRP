<odoo>

    <!-- Advance Reorder Process -->
    <record id="advance_reorder_orderprocess_company_rule" model="ir.rule">
        <field name="name">Advance Reorder Process - Company</field>
        <field name="model_id" ref="model_advance_reorder_orderprocess"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- Advance Reorder Planner -->
    <record id="advance_reorder_planner_company_rule" model="ir.rule">
        <field name="name">Advance Reorder Planner - Company</field>
        <field name="model_id" ref="model_advance_reorder_planner"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- Warehouse Group -->
    <record id="stock_warehouse_group_company_rule" model="ir.rule">
        <field name="name">Warehouse Group - Company</field>
        <field name="model_id" ref="model_stock_warehouse_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>


</odoo>